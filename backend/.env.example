# ─── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Database (PostgreSQL — required for production) ───────────────────────────
# Neon / Railway / Supabase: paste your connection string here
# Example (Neon): postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Legacy (optional if DATABASE_URL is not set):
# DB_NAME=ibbul_result_checker
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# ─── Frontend URL (password reset + invitation links) ───────────────────────
FRONTEND_BASE_URL=http://localhost:3000

# ─── Cloudinary (all media: logos, backgrounds, lesson video/PDF) ───────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BRANDING_FOLDER=ibbul/branding
CLOUDINARY_LEARNING_FOLDER=ibbul/learning
MEDIA_USE_CLOUDINARY=True

# ─── Email / SMTP (required for invitations + password reset) ────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=IBBUL Academic OS <noreply@ibbul.edu.ng>

# ─── Institution branding (transactional emails — text defaults) ─────────────
INSTITUTION_NAME=Ibrahim Badamasi Babangida University, Lapai
INSTITUTION_SHORT_NAME=IBBUL
PLATFORM_NAME=IBBUL Academic OS
PLATFORM_TAGLINE=Learning for Service
EMAIL_ACCENT_COLOR=#C9A227
SUPPORT_EMAIL=ict@ibbul.edu.ng

# ─── Celery (optional — background upload processing) ───────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
