# Docker Compose Environment Variables Example
# Copy this file to .env and update with your actual values

# Database
DB_NAME=ibbul_result_checker
DB_USER=postgres
DB_PASSWORD=postgres

# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# Celery (Redis)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Frontend URL (invitation + password reset links)
FRONTEND_BASE_URL=http://localhost:3000

# Email / SMTP — required for invitation & password reset delivery
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=IBBUL Academic OS <noreply@ibbul.edu.ng>

# Institution branding in emails
INSTITUTION_NAME=Ibrahim Badamasi Babangida University, Lapai
INSTITUTION_SHORT_NAME=IBBUL
PLATFORM_NAME=IBBUL Academic OS
PLATFORM_TAGLINE=Learning for Service
EMAIL_LOGO_URL=
EMAIL_ACCENT_COLOR=#1a35af
SUPPORT_EMAIL=ict@ibbul.edu.ng

# AWS S3 (if using real S3 instead of MinIO)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=us-east-1
